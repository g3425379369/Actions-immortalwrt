
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'

config interface 'wan'
	option proto 'dhcp'
	option device 'br0'
	option hostname '*'
	option metric '10'
	option force_link '1'

config interface 'wan6'
	option proto 'dhcpv6'
	option device 'br0'
	option reqprefix 'no'
	option norelease '1'
	option metric '10'
	option force_link '1'

config device
	option type 'bridge'
	option name 'br0'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
